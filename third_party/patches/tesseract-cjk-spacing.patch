+// Wangshu: full-em CJK advances avoid false word spaces in extractors that
+// estimate gaps from font metrics. Compensating Tz preserves every raster and
+// existing word position; Latin keeps its original half-em metrics.
+static bool IsCjkText(char32 code) {
+  return (code >= 0x3400 && code <= 0x9fff) ||
+         (code >= 0xf900 && code <= 0xfaff) ||
+         (code >= 0x20000 && code <= 0x3134f) ||
+         (code >= 0x3001 && code <= 0x303f) ||
+         (code >= 0xff01 && code <= 0xff60);
+}
+static int PdfWidthUnits(char32 code) {
+  // A supplementary scalar encodes as two half-em UTF-16 CIDs.
+  return IsCjkText(code) || code > 0xffff ? 2 : 1;
+}
